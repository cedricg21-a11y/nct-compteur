<?xml version="1.0" encoding="UTF-8"?>
<!-- Thème de carte sombre NCT pour Mapsforge -->
<rendertheme xmlns="http://mapsforge.org/renderTheme" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://mapsforge.org/renderTheme https://raw.githubusercontent.com/mapsforge/mapsforge/master/resources/renderTheme.xsd"
    version="6" map-background="#0c1219" map-background-outside="#0c1219">

    <!-- mer / eau -->
    <rule e="way" k="natural" v="sea">
        <area fill="#0f2233" />
    </rule>
    <rule e="way" k="natural" v="water|lake">
        <area fill="#123049" />
    </rule>
    <rule e="way" k="landuse" v="reservoir|basin">
        <area fill="#123049" />
    </rule>

    <!-- végétation, champs, zones -->
    <rule e="way" k="landuse" v="forest" zoom-min="10">
        <area fill="#102018" />
    </rule>
    <rule e="way" k="natural" v="wood|scrub" zoom-min="10">
        <area fill="#102018" />
    </rule>
    <rule e="way" k="landuse" v="meadow|grass|farmland|orchard|vineyard" zoom-min="12">
        <area fill="#0f1a16" />
    </rule>
    <rule e="way" k="landuse" v="residential|retail|commercial" zoom-min="11">
        <area fill="#121a24" />
    </rule>
    <rule e="way" k="landuse" v="industrial" zoom-min="11">
        <area fill="#141a22" />
    </rule>
    <rule e="way" k="leisure" v="park|pitch|golf_course" zoom-min="12">
        <area fill="#10221a" />
    </rule>

    <!-- bâtiments -->
    <rule e="way" k="building" v="*" zoom-min="14">
        <area fill="#1a2430" stroke="#202c3a" stroke-width="0.1" />
    </rule>

    <!-- rivières -->
    <rule e="way" k="waterway" v="river|canal" zoom-min="9">
        <line stroke="#123049" stroke-width="1.2" />
    </rule>
    <rule e="way" k="waterway" v="stream|ditch|drain" zoom-min="13">
        <line stroke="#123049" stroke-width="0.4" />
    </rule>

    <!-- voies ferrées -->
    <rule e="way" k="railway" v="rail" zoom-min="11">
        <line stroke="#3a4656" stroke-width="0.35" stroke-dasharray="10,6" />
    </rule>

    <!-- routes : bordures (dessinées d'abord) -->
    <rule e="way" k="highway" v="*">
        <rule e="way" k="highway" v="motorway|trunk|motorway_link|trunk_link">
            <line stroke="#05080b" stroke-width="2.4" stroke-linecap="butt" />
        </rule>
        <rule e="way" k="highway" v="primary|primary_link">
            <line stroke="#05080b" stroke-width="2.0" stroke-linecap="butt" />
        </rule>
        <rule e="way" k="highway" v="secondary|secondary_link" zoom-min="9">
            <line stroke="#05080b" stroke-width="1.7" stroke-linecap="butt" />
        </rule>
        <rule e="way" k="highway" v="tertiary|tertiary_link" zoom-min="11">
            <line stroke="#05080b" stroke-width="1.4" stroke-linecap="butt" />
        </rule>
        <rule e="way" k="highway" v="residential|unclassified|living_street|road" zoom-min="13">
            <line stroke="#05080b" stroke-width="1.1" stroke-linecap="butt" />
        </rule>
    </rule>

    <!-- routes : remplissage -->
    <rule e="way" k="highway" v="*">
        <rule e="way" k="highway" v="track|bridleway" zoom-min="14">
            <line stroke="#5a4a36" stroke-width="0.35" stroke-dasharray="8,5" />
        </rule>
        <rule e="way" k="highway" v="path|footway|steps|pedestrian" zoom-min="15">
            <line stroke="#4a5868" stroke-width="0.25" stroke-dasharray="5,5" />
        </rule>
        <rule e="way" k="highway" v="cycleway" zoom-min="13">
            <line stroke="#0b8f80" stroke-width="0.5" stroke-dasharray="10,5" />
        </rule>
        <rule e="way" k="highway" v="service" zoom-min="14">
            <line stroke="#4a5868" stroke-width="0.5" />
        </rule>
        <rule e="way" k="highway" v="residential|unclassified|living_street|road" zoom-min="13">
            <line stroke="#6f7f90" stroke-width="0.8" />
        </rule>
        <rule e="way" k="highway" v="tertiary|tertiary_link" zoom-min="11">
            <line stroke="#a3afbb" stroke-width="1.0" />
        </rule>
        <rule e="way" k="highway" v="secondary|secondary_link" zoom-min="9">
            <line stroke="#c9d1d9" stroke-width="1.25" />
        </rule>
        <rule e="way" k="highway" v="primary|primary_link">
            <line stroke="#e9eef3" stroke-width="1.5" />
        </rule>
        <rule e="way" k="highway" v="motorway|trunk|motorway_link|trunk_link">
            <line stroke="#e8a35a" stroke-width="1.8" />
        </rule>
    </rule>

    <!-- noms des routes -->
    <rule e="way" k="highway" v="primary|secondary|tertiary|residential|unclassified" zoom-min="14">
        <pathText k="name" font-style="bold" font-size="11" fill="#9aa8b6" stroke="#0c1219" stroke-width="3" />
    </rule>
    <rule e="way" k="highway" v="primary|secondary|tertiary" zoom-min="12">
        <pathText k="ref" font-style="bold" font-size="11" fill="#c9d1d9" stroke="#0c1219" stroke-width="3" />
    </rule>

    <!-- localités -->
    <rule e="node" k="place" v="city|town">
        <caption k="name" font-style="bold" font-size="17" fill="#eef3f7" stroke="#0c1219" stroke-width="3" />
    </rule>
    <rule e="node" k="place" v="village" zoom-min="11">
        <caption k="name" font-style="bold" font-size="14" fill="#c9d1d9" stroke="#0c1219" stroke-width="3" />
    </rule>
    <rule e="node" k="place" v="hamlet|locality" zoom-min="14">
        <caption k="name" font-size="12" fill="#8a9bb0" stroke="#0c1219" stroke-width="3" />
    </rule>
</rendertheme>
